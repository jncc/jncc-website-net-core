{
  "$schema": "../../umbraco-package-schema.json",
  "name": "JNCC.EditorStyles",
  "version": "0.1.0",
  "extensions": [
    {
      "name": "TipTap - JNCC Styles",
      "alias": "TipTap.JNCCStyles",
      "type": "tiptapToolbarExtension",
      "kind": "styleMenu",
      "weight": 100,
      "meta": {
        "alias": "JNCC.StyleMenu",
        "icon": "icon-palette",
        "label": "Style Select (JNCC)"
      },
      "items": [
        {
          "label": "Headings",
          "items": [
            {
              "label": "Heading 2",
              "data": {
                "tag": "h2"
              },
              "appearance": {
                "icon": "icon-heading-2",
                "style": "font-size: 1.8em;font-weight: 900;"
              }
            },
            {
              "label": "Heading 3",
              "data": {
                "tag": "h3"
              },
              "appearance": {
                "icon": "icon-heading-3",
                "style": "font-size: 1.385em;font-weight: 900;"
              }
            },
            {
              "label": "Heading 4",
              "data": {
                "tag": "h4"
              },
              "appearance": {
                "icon": "icon-heading-4",
                "style": "font-size: 1em;font-weight: 900;color:"
              }
            }
          ]
        },
        {
          "label": "Floats",
          "items": [
            {
              "label": "Float Left",
              "data": {
                "tag": "span",
                "class": "float-left"
              },
              "appearance": {
                "icon": "icon-text-align-left"
              }
            },
            {
              "label": "Float Right",
              "data": {
                "tag": "span",
                "class": "float-right"
              },
              "appearance": {
                "icon": "icon-text-align-right"
              }
            },
            {
              "label": "Border",
              "data": {
                "tag": "span",
                "class": "with-border"
              },
              "appearance": {
                "icon": "icon-grid-2"
              }
            },
            {
              "label": "Clear Floats",
              "data": {
                "tag": "span",
                "class": "clearfix"
              },
              "appearance": {
                "icon": "icon-delete"
              }
            }
          ]
        },
        {
          "label": "Text",
          "items": [
            {
              "label": "Paragraph",
              "data": {
                "tag": "p"
              },
              "appearance": {
                "icon": "icon-paragraph"
              }
            },
            {
              "label": "Highlight",
              "data": {
                "tag": "span",
                "class": "highlight"
              },
              "appearance": {
                "icon": "icon-edit",
                "style": "background-color: #ffff0080;padding: 0.4rem;"
              }
            }
          ]
        }
      ]
    }
  ]
}