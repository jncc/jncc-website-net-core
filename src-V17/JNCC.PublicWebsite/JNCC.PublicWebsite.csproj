<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <Configurations>Debug;Release;Development;Staging;Localhost</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="App_Plugins\Styles\umbraco-package.json" />
    <Content Include="App_Plugins\TwoFactor\umbraco-package.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CMSImport" />
    <PackageReference Include="Diplo.GodMode" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NWebsec.AspNetCore.Middleware" />
    <PackageReference Include="SEOChecker" />
    <PackageReference Include="System.Text.Encodings.Web" />
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <PackageReference Include="Umbraco.Community.CSPManager" />
    <PackageReference Include="Umbraco.Deploy.OnPrem" />
    <PackageReference Include="Umbraco.Forms" />
    <PackageReference Include="Umbraco.StorageProviders.AzureBlob" />
    <PackageReference Include="Umbraco.StorageProviders.AzureBlob.ImageSharp" />
    <ProjectReference Include="..\JNCC.PublicWebsite.Core\JNCC.PublicWebsite.Core.csproj" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\css\svgs\fi-x-twitter.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="IISUrlRewrite.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="umbraco\Licenses\umbracoDeploy.lic">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="umbraco\Licenses\umbracoForms.lic">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <UserSecretsId>ae983693-1498-4d3c-87bf-78bba41951e3</UserSecretsId>
  </PropertyGroup>
</Project>
