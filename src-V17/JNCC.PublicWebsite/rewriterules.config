  <!-- 250 exact-match entries in the "LegacyDocsRedirects" rewrite map (rewritemaps.config) -->
  <rule name="Redirect legacy /docs/ files" stopProcessing="true">
    <match url="^docs/.*$" ignoreCase="true"/>
    <conditions>
      <add input="{LegacyDocsRedirects:{REQUEST_URI}}" pattern="^(.+)$"/>
    </conditions>
    <action type="Redirect" url="https://jncc.gov.uk{C:1}" redirectType="Permanent"/>
  </rule>
  <!-- 1 exact-match entries in the "LegacyDocsRedirectsExternal" rewrite map (rewritemaps.config) -->
  <rule name="Redirect legacy /docs/ files (external hosts)" stopProcessing="true">
    <match url="^docs/.*$" ignoreCase="true"/>
    <conditions>
      <add input="{LegacyDocsRedirectsExternal:{REQUEST_URI}}" pattern="^(.+)$"/>
    </conditions>
    <action type="Redirect" url="{C:1}" redirectType="Permanent"/>
  </rule>
  <!-- Pattern-based (non-literal) entries kept as regex rules -->
  <rule name="Redirect docs to /resources/dbed70d8-6102-4246-8d42-f330c5b5434f" stopProcessing="true">
    <match url="^docs/.*$" ignoreCase="true"/>
    <conditions>
      <add input="{REQUEST_URI}" pattern="^/(docs/1\s+Reporting\s+Template\s+April\s+2019\s+\.xlsx|docs/10\s+Reporting\s+Template\s+January\s+2019a\s+\.xlsx|docs/11\s+Reporting\s+Template\s+February\s+2019\s+\.xlsx|docs/12\s+Reporting\s+Template\s+March\s+2019\s+\.xlsx)$"/>
    </conditions>
    <action type="Redirect" url="https://jncc.gov.uk/resources/dbed70d8-6102-4246-8d42-f330c5b5434f" redirectType="Permanent"/>
  </rule>
