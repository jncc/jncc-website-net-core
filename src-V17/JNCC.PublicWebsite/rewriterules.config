  <!-- 2318 exact-match entries in the "LegacyPageIdRedirects" rewrite map (rewritemaps.config) -->
  <rule name="Redirect legacy default.aspx?page= URLs" stopProcessing="true">
    <match url="^default\.aspx$" ignoreCase="true"/>
    <conditions>
      <add input="{LegacyPageIdRedirects:{QUERY_STRING}}" pattern="^(.+)$"/>
    </conditions>
    <action type="Redirect" url="https://jncc.gov.uk{C:1}" redirectType="Permanent"/>
  </rule>
  <!-- 20 exact-match entries in the "LegacyPageIdRedirectsExternal" rewrite map (rewritemaps.config) -->
  <rule name="Redirect legacy default.aspx?page= URLs (external hosts)" stopProcessing="true">
    <match url="^default\.aspx$" ignoreCase="true"/>
    <conditions>
      <add input="{LegacyPageIdRedirectsExternal:{QUERY_STRING}}" pattern="^(.+)$"/>
    </conditions>
    <action type="Redirect" url="{C:1}" redirectType="Permanent"/>
  </rule>
  <!-- Pattern-based (non-literal) entries kept as regex rules -->
  <rule name="Redirect to /" stopProcessing="true">
    <match url="^default\.aspx$" ignoreCase="true"/>
    <conditions>
      <add input="{QUERY_STRING}" pattern="^(page=2183&amp;q=darwin\s+mounds|page=2183&amp;q=darwin\s+mounds&amp;terms=darwin\s+mounds|page=6896\?fbclid=IwAR19ZMPhwDnoK9Tjp7RhlNWmJ9VyVoD_YTHoWmmBDfqlTy1pwIKznM49-Ms)$"/>
    </conditions>
    <action type="Redirect" url="https://jncc.gov.uk/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect old SAC sites">
    <match url="^protectedsites\/SACselection\/sac\.asp"/>
    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
      <add input="{QUERY_STRING}" pattern="^EUcode=([A-Z0-9]*)"/>
    </conditions>
    <action type="Redirect" url="https://sac.jncc.gov.uk/site/{C:1}" appendQueryString="false" redirectType="Permanent"/>
  </rule>
  <rule name="Redirect old SAC sites 2">
    <match url="^protectedsites\/SACselection\/bap\.asp"/>
    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
      <add input="{QUERY_STRING}" pattern="^EUcode=([A-Z0-9]*)"/>
    </conditions>
    <action type="Redirect" url="https://sac.jncc.gov.uk/site/{C:1}" appendQueryString="false" redirectType="Permanent"/>
  </rule>
</rules>