<rules>
  <rule name="Ignore vsas.zip" stopProcessing="true">
    <match url="^vsas\.zip$" ignoreCase="true"/>
    <conditions logicalGrouping="MatchAll" trackAllCaptures="false"/>
    <action type="None"/>
  </rule>

  <rule name="Redirect resources to main site" stopProcessing="true">
    <match url="^resources(/.*)?$"/>
    <conditions>
      <add input="{HTTP_HOST}" pattern="^hub\.jncc\.gov\.uk$"/>
    </conditions>
    <action type="Redirect" url="https://jncc.gov.uk/resources{R:1}" redirectType="Permanent"/>
  </rule>
  <rule name="Redirect hub root to resources" stopProcessing="true">
    <match url="^$"/>
    <conditions>
      <add input="{HTTP_HOST}" pattern="^hub\.jncc\.gov\.uk$"/>
    </conditions>
    <action type="Redirect" url="https://jncc.gov.uk/resources/" redirectType="Permanent"/>
  </rule>


  <rule name="Redirect PDF files to access-to-information" stopProcessing="true">
    <match url="^pdf/(2014\d{2}(_Redacted)?|2015\d{2}|2016\d{2}|2017\d{2}|2018\d{2}|2019\d{2})\.pdf$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/about-jncc/corporate-information/access-to-information/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect biotope JNCCMNCR00000324" stopProcessing="true">
    <match url="^marine/biotopes/biotope\.aspx$" ignoreCase="true"/>
    <conditions>
      <add input="{QUERY_STRING}" pattern="^biotope=JNCCMNCR00000324$"/>
    </conditions>
    <action type="Redirect" url="https://mhc.jncc.gov.uk/biotopes/JNCCMNCR0000032" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect BiotopeSearch.aspx" stopProcessing="true">
    <match url="^marine/biotopes/BiotopeSearch\.aspx$" ignoreCase="true"/>
    <action type="Redirect" url="https://mhc.jncc.gov.uk/search/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect hierarchy.aspx no level" stopProcessing="true">
    <match url="^marine/biotopes/hierarchy\.aspx$" ignoreCase="true"/>
    <action type="Redirect" url="https://mhc.jncc.gov.uk/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect hierarchy.aspx levels 1-5" stopProcessing="true">
    <match url="^marine/biotopes/hierarchy\.aspx$" ignoreCase="true"/>
    <conditions>
      <add input="{QUERY_STRING}" pattern="^level=[1-5]$"/>
    </conditions>
    <action type="Redirect" url="https://mhc.jncc.gov.uk/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect marinehabitatclassification" stopProcessing="true">
    <match url="^(marinehabitatclassification|MarineHabitatClassification/)$" ignoreCase="true"/>
    <action type="Redirect" url="https://mhc.jncc.gov.uk/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect marinehabitatcorrelation" stopProcessing="true">
    <match url="^marinehabitatcorrelation$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/resources/62a16757-e0d1-4a29-a98e-948745804aec" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect MarineMonitoringHandbook" stopProcessing="true">
    <match url="^MarineMonitoringHandbook$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/resources/ed51e7cc-3ef2-4d4f-bd3c-3d82ba87ad95" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect marineprotectedareas" stopProcessing="true">
    <match url="^marineprotectedareas$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/advice/marine-protected-areas/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect marinerecorder Snapshot" stopProcessing="true">
    <match url="^marinerecorder/default\.asp$" ignoreCase="true"/>
    <conditions>
      <add input="{QUERY_STRING}" pattern="^Product=Snapshot$"/>
    </conditions>
    <action type="Redirect" url="http://www.esdm.co.uk/MarineRecorder/index.html?Product=Snapshot" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect NatureNews" stopProcessing="true">
    <match url="^NatureNews$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/about-jncc/corporate-information/newsletters/" redirectType="Permanent"/>
  </rule>

  <rule name="Redirect offshoreMPAs" stopProcessing="true">
    <match url="^offshoreMPAs$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/our-work/offshore-mpas/" redirectType="Permanent"/>
