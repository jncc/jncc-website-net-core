  <rule name="Redirect opendata" stopProcessing="true">
    <match url="^opendata$" ignoreCase="true"/>
    <action type="Redirect" url="https://jncc.gov.uk/about-jncc/corporate-information/open-data/" redirectType="Permanent"/>
